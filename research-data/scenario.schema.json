{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ievf/research-data/scenario.schema.json",
  "title": "IEVF bounded benchmark scenario manifest",
  "type": "object",
  "required": ["schema_version", "description", "scenarios"],
  "properties": {
    "schema_version": {"const": 1},
    "description": {"type": "string", "minLength": 1},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "positiveInteger": {"type": "integer", "minimum": 1},
    "scenario": {
      "type": "object",
      "required": ["name", "m", "k", "n", "warmup", "iterations", "seed", "verify", "require_native", "max_memory_bytes"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "m": {"$ref": "#/$defs/positiveInteger"},
        "k": {"$ref": "#/$defs/positiveInteger"},
        "n": {"$ref": "#/$defs/positiveInteger"},
        "warmup": {"type": "integer", "minimum": 0},
        "iterations": {"$ref": "#/$defs/positiveInteger"},
        "seed": {"type": "integer"},
        "verify": {"type": "boolean"},
        "require_native": {"type": "boolean"},
        "max_memory_bytes": {"$ref": "#/$defs/positiveInteger"}
      },
      "additionalProperties": false
    }
  }
}
